@model List<Dating.Models.Register>
@{
    Layout = null;
}
<!DOCTYPE html><html><head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Search - DatingSite</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="#">DatingSite</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Profile", "Profile")">Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active fw-bold" href="@Url.Action("Search", "Search")">Search</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger fw-bold" href="@Url.Action("Logout", "Profile")">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        <form method="get" action="@Url.Action("Search", "Search")" class="mb-3">
            <div class="input-group">
                <input type="text" name="username" class="form-control" placeholder="Search by name..." value="@(Request.QueryString["username"] ?? "")" />
                <button class="btn btn-outline-secondary" type="submit">Search</button>
            </div>

            <!-- Age range filters -->
            <div class="row g-2 mt-2">
                <div class="col-6">
                    <div class="input-group">
                        <span class="input-group-text">Min Age</span>
                        <input type="number" name="minAge" min="0" class="form-control" placeholder="Min" value="@(Request.QueryString["minAge"] ?? "")" />
                    </div>
                </div>
                <div class="col-6">
                    <div class="input-group">
                        <span class="input-group-text">Max Age</span>
                        <input type="number" name="maxAge" min="0" class="form-control" placeholder="Max" value="@(Request.QueryString["maxAge"] ?? "")" />
                    </div>
                </div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-12">
                    <div class="input-group">
                        <span class="input-group-text">Programming Language</span>
                        <select name="programmingLanguage" class="form-control">
                            <option value="">All Languages</option>
                            @foreach (var lang in ViewBag.ProgrammingLanguages)
                            {
                                <option value="@lang" @(Request.QueryString["programmingLanguage"] == lang ? "selected" : "")>@lang</option>
                            }
                        </select>  
                    </div>
                </div>
            </div>
        </form>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>Find Matches</h2>
            <span class="badge bg-secondary">@(Model?.Count ?? 0) Users Found</span>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-info">
                No other registered users were found.
            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var user in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            <div class="card-body">
                                <h5 class="card-title text-primary">@user.FirstName @user.LastName</h5>
                                <h6 class="card-subtitle mb-2 text-muted">@@@user.Username</h6>
                                <hr />
                                <p class="card-text mb-1">
                                    <strong>Age:</strong> @user.Age
                                </p>
                                <p class="card-text">
                                    <strong>Favorite Language:</strong>
                                    <span class="badge bg-primary">@user.ProgrammingLanguage</span>
                                </p>
                            </div>
                            <div class="card-footer bg-transparent border-top-0 pb-3">
                                <button class="btn btn-outline-primary btn-sm w-100">Connect</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </main>

    <footer class="bg-light text-center py-3 mt-auto">
        <div class="container">
            <small>&copy; 2026 DatingSite by Kovg.</small>
        </div>
    </footer>

    <!-- Bootstrap JS bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script></body></html>