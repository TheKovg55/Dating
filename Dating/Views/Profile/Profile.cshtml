@model Dating.Models.Register
@{
    Layout = null;
}<!DOCTYPE html><html><head>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Profile</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <div class="container">
            <a class="navbar-brand" href="#">DatingSite</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Profile", "Profile")">Profile</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Search", "Search")">Search</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-danger fw-bold" href="@Url.Action("Logout", "Profile")">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="container my-4">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h3 class="card-title mb-0">User Profile</h3>
                    </div>
                    <div class="card-body">
                        <h4 class="mb-3">Welcome, @Model.FirstName @Model.LastName!</h4>
                        <hr />

                        @if (ViewBag.UpdateMessage != null)
                        {
                            <div class="alert alert-success alert-dismissible fade show mb-3" role="alert">
                                @ViewBag.UpdateMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>
                        }

                        @using (Html.BeginForm("Profile", "Profile", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            @* Preserve Password across model post *@
                            <input type="hidden" name="Password" value="@Model.Password" />

                            <div class="mb-3 row align-items-center">
                                <label class="col-sm-4 col-form-label text-muted">First Name</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" name="FirstName" value="@Model.FirstName" required />
                                </div>
                            </div>

                            <div class="mb-3 row align-items-center">
                                <label class="col-sm-4 col-form-label text-muted">Last Name</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" name="LastName" value="@Model.LastName" required />
                                </div>
                            </div>

                            <div class="mb-3 row align-items-center">
                                <label class="col-sm-4 col-form-label text-muted">Age</label>
                                <div class="col-sm-8">
                                    <input type="number" class="form-control" name="Age" value="@Model.Age" required />
                                </div>
                            </div>

                            <div class="mb-3 row align-items-center">
                                <label class="col-sm-4 col-form-label text-muted">Programming Language</label>
                                <div class="col-sm-8">
                                    <select class="form-control" name="ProgrammingLanguage" required>
                                        <option value="">Select a programming language</option>
                                        @foreach (string lang in ViewBag.ProgrammingLanguages)
                                        {
                                            <option value="@lang" @(lang == Model.ProgrammingLanguage ? "selected" : "")>@lang</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="mb-3 row align-items-center">
                                <label class="col-sm-4 col-form-label text-muted">Username</label>
                                <div class="col-sm-8">
                                    <input type="text" class="form-control" name="Username" value="@Model.Username" required />
                                </div>
                            </div>

                            <div class="d-grid mt-4">
                                <button type="submit" class="btn btn-primary">Save Changes</button>
                            </div>
                        }

                    </div>
                </div>
            </div>
        </div>
    </main>

    <footer class="bg-light text-center py-3 mt-auto">
        <div class="container">
            <small>&copy; 2026 DatingSite by Kovg.</small>
        </div>
    </footer>

    <!-- Bootstrap JS bundle (includes Popper) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script></body></html>